#!/usr/bin/env python3
"""sf-search — CLI entry point for the SciForge search skill.

Modes:

  sf-search doctor
  sf-search "keyword query"                                [--top N ...]
  sf-search --query 'raw boolean' [--top N ...]
  sf-search --title T [--author A ...] [--year 2020..2024] [--top N ...]
  sf-search --from-strategy strategy.json                  [--top N ...]
  sf-search --from-file queries.txt                        [--top N ...]

  sf-search mesh lookup --concept X [--concept Y ...]
  sf-search mesh build --mesh X --synonym Y [--op AND|OR] [-o strategy.json]
  sf-search mesh check strategy.json

See SKILL.md and references/*.md for the full contract.

Stdlib only — no third-party runtime deps.
"""

from __future__ import annotations

import sys
from pathlib import Path

# Make `scripts/` importable so the modules below (`main`, `config`, ...)
# resolve as flat modules — mirrors sf-download's entry-point convention.
_HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE))

from main import main  # noqa: E402


if __name__ == "__main__":
    sys.exit(main())
