#!/usr/bin/env python3
"""litlib — deprecated shim; forwards to sf-lit.

The literature skill's CLI was renamed from `litlib` to `sf-lit` per
ADR-0005 (SciForge `sf-` naming). This shim keeps existing invocations
working until v1.0. It prints a one-line deprecation notice to stderr
and then execs `sf-lit` with the same arguments.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> int:
    here = Path(__file__).resolve().parent
    target = here / "sf-lit"
    if not target.exists():
        sys.stderr.write(
            "litlib: cannot locate sf-lit next to this shim "
            f"(expected {target}). Reinstall the skill.\n"
        )
        return 1

    sys.stderr.write(
        "litlib: deprecated — use `sf-lit` (ADR-0005). "
        "This shim will be removed in v1.0.\n"
    )

    argv = [sys.executable, str(target), *sys.argv[1:]]
    if os.name == "nt":
        # On Windows os.execv replaces the process but Python resolves
        # sys.executable oddly under some launchers; spawn + wait is safer.
        import subprocess

        return subprocess.call(argv)
    os.execv(sys.executable, argv)
    return 0  # unreachable


if __name__ == "__main__":
    raise SystemExit(main())
